# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Backend API Configuration
REACT_APP_API_BASE_URL=http://localhost:8000/api

# Gemini AI Configuration
# Free-tier keys allow only ~20 generations per day per model. The app falls back through
# several models automatically, but enable billing in Google AI Studio for heavy use.
REACT_APP_GEMINI_API_KEY=your_gemini_api_key
REACT_APP_GEMINI_MODEL=gemini-3.5-flash
# Optional safety valves (milliseconds). Defaults: 100000 per request, 220000 overall.
# REACT_APP_GEMINI_TIMEOUT_MS=100000
# REACT_APP_GEMINI_TOTAL_BUDGET_MS=220000

# Other Configuration
REACT_APP_ENVIRONMENT=development
