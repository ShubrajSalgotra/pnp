[ChapterName "ENDGAMES FOR MASTERS (2200-2399): The Principe of the Two Weaknesses (Smyslov -"]
[ChapterURL "https://lichess.org/study/iUmzy9iJ/g2hVbRnu"]
[FEN "8/3r1pkp/1p2pp2/8/nP1N4/4PKP1/5P1P/2R5 w - - 0 1"]
