[ChapterName "ENDGAMES FOR MASTERS (2200-2399): All King and Pawn Endgames are Confusing ! (S"]
[ChapterURL "https://lichess.org/study/iUmzy9iJ/RYPZWh2O"]
[FEN "8/8/1p6/p2q4/P5p1/1P4Q1/k4P1K/8 b - - 0 1"]
[SetUp "1"]
